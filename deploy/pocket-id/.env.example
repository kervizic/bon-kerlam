# Fichier d'exemple pour Pocket ID (https://id.kerlam.fr).
# Copier en .env sur le VPS. NE JAMAIS committer de secret reel.

# URL publique de l'instance (doit matcher le vhost nginx et les redirect URIs).
APP_URL=https://id.kerlam.fr

# Pocket ID est derriere le reverse proxy nginx : faire confiance aux en-tetes
# X-Forwarded-* pour reconstruire l'URL / l'IP client.
TRUST_PROXY=true

# Cle de chiffrement / maintenance :
# Pocket ID genere et stocke ses cles dans le volume ./data au premier demarrage.
# Ne pas supprimer ce volume (sinon invalidation des sessions et des cles de
# signature des tokens). Si une variable de cle de maintenance est requise par
# la version deployee (ex. MAINTENANCE / ENCRYPTION_KEY selon la release),
# la renseigner ici avec une valeur generee par : openssl rand -hex 32
# ENCRYPTION_KEY=
