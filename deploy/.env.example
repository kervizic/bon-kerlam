# ===========================================================================
# bon-kerlam — modèle d'environnement. COPIER en deploy/.env puis remplir.
# NE JAMAIS committer deploy/.env. Aucune vraie valeur ici.
# Générer les secrets SUR LE SERVEUR (voir deploy/README.md).
# ===========================================================================

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=__openssl_rand_base64_24__
# Mot de passe du rôle applicatif bon_worker (distinct conseillé).
WORKER_DB_PASSWORD=__openssl_rand_base64_24__

# --- JWT (HS256) ----------------------------------------------------------
JWT_SECRET=__openssl_rand_hex_32__
JWT_EXPIRY=3600
# Clés API dérivées du JWT_SECRET (deploy/scripts/gen-jwt.py).
ANON_KEY=__jwt_role_anon__
SERVICE_ROLE_KEY=__jwt_role_service_role__

# --- URLs -----------------------------------------------------------------
API_EXTERNAL_URL=https://api.kerlam.fr
SITE_URL=https://bon.kerlam.fr
ADDITIONAL_REDIRECT_URLS=https://bon.kerlam.fr

# --- Schémas exposés par PostgREST ---------------------------------------
PGRST_DB_SCHEMAS=api,svc,storage

# --- Connexion Google (Supabase Auth) ------------------------------------
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=__xxxxx.apps.googleusercontent.com__
GOOGLE_SECRET=__google_client_secret__
# Restriction de domaine (hd) optionnelle, vide = désactivée.
GOOGLE_HD=

# --- Connexion par code OTP e-mail (6 chiffres) --------------------------
# SMTP importé depuis Documenso : deploy/scripts/import-smtp-from-documenso.sh
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=bon@kerlam.fr
GOTRUE_SMTP_SENDER_NAME=KERLAM
# Modèle FR du code (monté dans le conteneur). Vide = modèle intégré GoTrue.
GOTRUE_MAILER_TEMPLATES_MAGIC_LINK=file:///etc/gotrue/otp_fr.html
# Hook « before user created » (refuse les e-mails hors liste blanche) si GoTrue
# le permet. URI du type pg-functions://postgres/bon/gotrue_before_user_created
GOTRUE_HOOK_BEFORE_USER_CREATED_ENABLED=false
GOTRUE_HOOK_BEFORE_USER_CREATED_URI=

# --- Stockage S3 OVH ------------------------------------------------------
S3_BUCKET=kerlam-bon
S3_REGION=eu-west-par
S3_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net
S3_ACCESS_KEY=__ovh_s3_access_key__
S3_SECRET_KEY=__ovh_s3_secret_key__

# --- Worker / app ---------------------------------------------------------
APP_VERSION=0.1.0-beta.1
GIT_SHA=unknown
GEOCODE_ON_START=true
KERLAM_SIREN=

# --- Documenso (connexion Google native, hors périmètre de cette pile) ----
# Documenté ici pour mémoire ; géré par le déploiement Documenso existant.
# NEXT_PRIVATE_GOOGLE_CLIENT_ID=
# NEXT_PRIVATE_GOOGLE_CLIENT_SECRET=
