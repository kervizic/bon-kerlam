# Fichier d'exemple pour bon.kerlam.fr.
# Copier en .env et renseigner les vraies valeurs sur le VPS.
# NE JAMAIS committer de secret reel. Ce fichier ne contient que des exemples.

# Tag de l'image a deployer (ghcr.io/kervizic/bon-kerlam:<BON_VERSION>).
BON_VERSION=0.1.0-beta.1

# Environnement applicatif : production sur le VPS, dev en local.
APP_ENV=production

# Version applicative. Injectee au build de l'image ; surchargeable ici si besoin.
APP_VERSION=

# SHA git du build (tracabilite). Injecte au build, surchargeable ici si besoin.
GIT_SHA=

# SIREN du transporteur KERLAM (mention obligatoire sur la lettre de voiture).
CARRIER_SIREN=

# Secret de signature des cookies de session.
# Generer avec : openssl rand -hex 32
SESSION_SECRET=

# Cookies en Secure (HTTPS uniquement). Toujours true en production.
COOKIE_SECURE=true

# Repertoire de donnees dans le conteneur (correspond au volume ./data:/data).
DATA_DIR=/data

# --- OIDC (Pocket ID sur https://id.kerlam.fr) ---
OIDC_ISSUER=https://id.kerlam.fr
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://bon.kerlam.fr/api/auth/callback
# Claim portant les groupes de l'utilisateur dans le token OIDC.
OIDC_GROUPS_CLAIM=groups
# Groupe donnant acces au role bureau.
OIDC_GROUP_BUREAU=bon-bureau
# Groupe donnant acces au role chauffeur.
OIDC_GROUP_CHAUFFEUR=bon-chauffeur

# Login de developpement (bypass OIDC). TOUJOURS false en production.
DEV_LOGIN=false
